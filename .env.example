# Copy to .env in the repo root. The server reads it on start; a variable set in the environment wins.

# The port players and the table screen connect to.
PORT=3001

# Where the campaign and the GM password hash are kept. Keep it out of source control and back it up.
# A relative path is read from apps/server, so the default is apps/server/data.
# DATA_DIR=data

# Only for a browser client served from another origin. The dev client proxies to the server and doesn't need it.
# CLIENT_ORIGIN=http://localhost:5173
