{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vtt.local/schemas/actor-definition.v1.schema.json",
  "title": "VTT actor definition v1",
  "description": "Mirror of the authoritative Zod ActorDefinitionSchema (packages/schemas/src/index.ts). Kept in lockstep by packages/schemas/test/actor-definition.test.ts; the Zod schema strips unknown keys where this document rejects them, so treat this file as the stricter authoring guide.",
  "type": "object",
  "required": ["schemaId", "schemaVersion", "source", "name", "size", "abilityScores", "proficiencyBonus", "armorClass", "hitPoints", "speedFeet"],
  "properties": {
    "schemaId": { "enum": ["vtt.actor-character", "vtt.actor-monster"] }, "schemaVersion": { "const": 1 },
    "source": { "type": "object", "required": ["name", "version"], "properties": { "name": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 }, "externalId": { "type": "string" } }, "additionalProperties": false },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 }, "summary": { "type": "string", "maxLength": 280 }, "size": { "$ref": "#/$defs/size" },
    "abilityScores": { "type": "object", "required": ["str", "dex", "con", "int", "wis", "cha"], "additionalProperties": false, "properties": { "str": { "$ref": "#/$defs/ability" }, "dex": { "$ref": "#/$defs/ability" }, "con": { "$ref": "#/$defs/ability" }, "int": { "$ref": "#/$defs/ability" }, "wis": { "$ref": "#/$defs/ability" }, "cha": { "$ref": "#/$defs/ability" } } },
    "proficiencyBonus": { "type": "integer", "minimum": 0, "maximum": 12 }, "armorClass": { "type": "integer", "minimum": 1, "maximum": 40 }, "hitPoints": { "type": "object", "required": ["maximum"], "properties": { "maximum": { "type": "integer", "minimum": 1 }, "formula": { "$ref": "#/$defs/dice" } }, "additionalProperties": false }, "initiativeBonus": { "type": "integer", "minimum": -20, "maximum": 30 }, "speedFeet": { "type": "integer", "minimum": 0 },
    "actions": { "type": "array", "items": { "$ref": "#/$defs/action" }, "maxItems": 100 },
    "token": { "type": "object", "properties": { "disposition": { "enum": ["friendly", "hostile", "neutral"] }, "footprint": { "type": "object", "required": ["width", "height"], "properties": { "width": { "type": "integer", "minimum": 1, "maximum": 4 }, "height": { "type": "integer", "minimum": 1, "maximum": 4 } }, "additionalProperties": false } }, "additionalProperties": false },
    "extensions": { "type": "object", "additionalProperties": true },
    "damageResistances": { "$ref": "#/$defs/damageTypeList" }, "damageImmunities": { "$ref": "#/$defs/damageTypeList" }, "damageVulnerabilities": { "$ref": "#/$defs/damageTypeList" },
    "conditionImmunities": { "type": "array", "items": { "$ref": "#/$defs/conditionId" }, "maxItems": 20 },
    "legendary": { "type": "object", "properties": { "actionsPerRound": { "type": "integer", "minimum": 1, "maximum": 5 }, "resistancesPerDay": { "type": "integer", "minimum": 1, "maximum": 6 } }, "additionalProperties": false },
    "character": { "type": "object", "additionalProperties": false, "properties": { "classes": { "type": "array", "maxItems": 4, "items": { "type": "object", "required": ["id", "name", "level"], "additionalProperties": false, "properties": { "id": { "$ref": "#/$defs/slug" }, "name": { "type": "string", "minLength": 1, "maxLength": 60 }, "subclass": { "$ref": "#/$defs/namedSlug" }, "level": { "type": "integer", "minimum": 1, "maximum": 20 }, "hitDie": { "$ref": "#/$defs/hitDie" } } } }, "race": { "type": "object", "required": ["id", "name"], "additionalProperties": false, "properties": { "id": { "$ref": "#/$defs/slug" }, "name": { "type": "string", "minLength": 1, "maxLength": 60 }, "subrace": { "$ref": "#/$defs/namedSlug" } } }, "background": { "$ref": "#/$defs/namedSlug" }, "feats": { "type": "array", "maxItems": 40, "items": { "type": "object", "required": ["id", "name"], "additionalProperties": false, "properties": { "id": { "$ref": "#/$defs/slug" }, "name": { "type": "string", "minLength": 1, "maxLength": 80 }, "description": { "type": "string", "maxLength": 4000 } } } }, "choices": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/characterChoice" } } } },
    "proficiencies": { "type": "object", "additionalProperties": false, "properties": { "saves": { "type": "array", "maxItems": 6, "items": { "$ref": "#/$defs/abilityId" } }, "skills": { "type": "array", "maxItems": 40, "items": { "type": "object", "required": ["id", "proficiency"], "additionalProperties": false, "properties": { "id": { "$ref": "#/$defs/slug" }, "proficiency": { "enum": ["proficient", "expertise"] } } } }, "saveOverrides": { "type": "object", "additionalProperties": { "type": "integer", "minimum": -20, "maximum": 30 } }, "skillOverrides": { "type": "object", "additionalProperties": { "type": "integer", "minimum": -20, "maximum": 30 } }, "armor": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/proficiencyId" } }, "weapons": { "type": "array", "maxItems": 60, "items": { "$ref": "#/$defs/proficiencyId" } }, "tools": { "type": "array", "maxItems": 40, "items": { "$ref": "#/$defs/proficiencyId" } }, "languages": { "type": "array", "maxItems": 30, "items": { "$ref": "#/$defs/proficiencyId" } } } },
    "spellcasting": { "type": "object", "required": ["ability"], "additionalProperties": false, "allOf": [{ "$comment": "Mirrors the Zod superRefine: per-class slots without the combined top-level pool would seed a caster with zero live slots.", "if": { "type": "object", "required": ["classes"], "properties": { "classes": { "contains": { "type": "object", "required": ["slots"], "properties": { "slots": { "minItems": 1 } } } } } }, "then": { "required": ["slots"], "properties": { "slots": { "minItems": 1 } } } }], "properties": { "ability": { "$ref": "#/$defs/abilityId" }, "saveDc": { "type": "integer", "minimum": 1, "maximum": 40 }, "attackBonus": { "type": "integer", "minimum": -5, "maximum": 30 }, "slots": { "type": "array", "maxItems": 9, "items": { "$ref": "#/$defs/spellSlotMax" } }, "pact": { "type": "object", "required": ["level", "max"], "additionalProperties": false, "properties": { "level": { "type": "integer", "minimum": 1, "maximum": 5 }, "max": { "type": "integer", "minimum": 0, "maximum": 4 } } }, "classes": { "type": "array", "maxItems": 4, "items": { "type": "object", "required": ["classId", "ability"], "additionalProperties": false, "properties": { "classId": { "$ref": "#/$defs/slug" }, "ability": { "$ref": "#/$defs/abilityId" }, "saveDc": { "type": "integer", "minimum": 1, "maximum": 40 }, "attackBonus": { "type": "integer", "minimum": -5, "maximum": 30 }, "slots": { "type": "array", "maxItems": 9, "items": { "$ref": "#/$defs/spellSlotMax" } }, "prepared": { "type": "integer", "minimum": 0, "maximum": 60 } } } }, "spells": { "type": "array", "maxItems": 400, "items": { "type": "object", "required": ["id", "name", "level"], "additionalProperties": false, "properties": { "id": { "type": "string", "maxLength": 80 }, "name": { "type": "string", "minLength": 1, "maxLength": 120 }, "level": { "type": "integer", "minimum": 0, "maximum": 9 }, "prepared": { "type": "boolean" }, "alwaysPrepared": { "type": "boolean" }, "actionId": { "$ref": "#/$defs/slug" }, "classId": { "$ref": "#/$defs/slug" } } } } } },
    "startingInventory": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/inventoryItem" } },
    "startingCurrency": { "$ref": "#/$defs/currency" }
  }, "additionalProperties": false,
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$", "maxLength": 80 },
    "abilityId": { "enum": ["str", "dex", "con", "int", "wis", "cha"] },
    "hitDie": { "enum": ["d4", "d6", "d8", "d10", "d12"] },
    "proficiencyId": { "type": "string", "pattern": "^[a-z0-9-]+$", "maxLength": 60 },
    "spellSlotMax": { "type": "object", "required": ["level", "max"], "additionalProperties": false, "properties": { "level": { "type": "integer", "minimum": 1, "maximum": 9 }, "max": { "type": "integer", "minimum": 0, "maximum": 9 } } },
    "characterChoice": { "type": "object", "required": ["level", "kind", "id"], "additionalProperties": false, "properties": { "level": { "type": "integer", "minimum": 1, "maximum": 20 }, "classId": { "type": "string", "pattern": "^[a-z0-9-]+$", "maxLength": 60 }, "kind": { "type": "string", "pattern": "^[a-z0-9-]+$", "maxLength": 60 }, "id": { "$ref": "#/$defs/slug" }, "payload": { "type": "object", "additionalProperties": true } } },
    "namedSlug": { "type": "object", "required": ["id", "name"], "additionalProperties": false, "properties": { "id": { "$ref": "#/$defs/slug" }, "name": { "type": "string", "minLength": 1, "maxLength": 60 } } },
    "coin": { "type": "integer", "minimum": 0, "maximum": 1000000 },
    "currency": { "type": "object", "additionalProperties": false, "properties": { "cp": { "$ref": "#/$defs/coin" }, "sp": { "$ref": "#/$defs/coin" }, "ep": { "$ref": "#/$defs/coin" }, "gp": { "$ref": "#/$defs/coin" }, "pp": { "$ref": "#/$defs/coin" } } },
    "inventoryItem": { "type": "object", "required": ["id", "name"], "additionalProperties": false, "properties": { "id": { "$ref": "#/$defs/slug" }, "name": { "type": "string", "minLength": 1, "maxLength": 120 }, "quantity": { "type": "integer", "minimum": 0, "maximum": 9999 }, "equipped": { "type": "boolean" }, "attuned": { "type": "boolean" }, "weightEach": { "type": "number", "minimum": 0 }, "description": { "type": "string", "maxLength": 4000 }, "category": { "type": "string", "pattern": "^[a-z0-9-]+$", "maxLength": 40 }, "weapon": { "type": "object", "additionalProperties": false, "required": ["category", "damageDice", "damageType", "rangeFeet", "longRangeFeet"], "properties": { "category": { "enum": ["simple", "martial"] }, "damageDice": { "type": "string", "minLength": 1, "maxLength": 20 }, "damageType": { "type": "string", "minLength": 1, "maxLength": 40 }, "rangeFeet": { "type": ["integer", "null"], "minimum": 1 }, "longRangeFeet": { "type": ["integer", "null"], "minimum": 1 }, "properties": { "type": "array", "maxItems": 12, "items": { "type": "string", "pattern": "^[a-z0-9-]+$", "maxLength": 40 } } } }, "armor": { "type": "object", "additionalProperties": false, "required": ["acBase", "addDexModifier", "dexModifierCap", "stealthDisadvantage", "strengthRequired"], "properties": { "acBase": { "type": "integer", "minimum": 2, "maximum": 25 }, "addDexModifier": { "type": "boolean" }, "dexModifierCap": { "type": ["integer", "null"] }, "stealthDisadvantage": { "type": "boolean" }, "strengthRequired": { "type": ["integer", "null"] } } }, "magic": { "type": "object", "additionalProperties": false, "properties": { "isMagic": { "type": "boolean" }, "attunementRequired": { "type": "boolean" }, "slot": { "$ref": "#/$defs/itemSlot" } } } } },
    "ability": { "type": "integer", "minimum": 1, "maximum": 30 },
    "dice": { "type": "string", "pattern": "^\\d+d(?:4|6|8|10|12|20|100)(?:\\s*[+-]\\s*\\d+)?$" },
    "size": { "enum": ["tiny", "small", "medium", "large", "huge", "gargantuan"] },
    "conditionId": { "type": "string", "pattern": "^[a-z0-9-]+$", "maxLength": 60 },
    "effectTag": { "type": "string", "pattern": "^[a-z0-9-]+$", "maxLength": 40 },
    "damageTypeList": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 40 }, "maxItems": 20 },
    "damageTypeId": { "type": "string", "minLength": 1, "maxLength": 40 },
    "itemSlot": { "enum": ["weapon", "shield", "armor", "head", "neck", "shoulders", "hands", "ring", "belt", "feet", "held", "wondrous", "consumable", "ammunition", "none"] },
    "slugList": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "$ref": "#/$defs/slug" } },
    "riderTrigger": {
      "$comment": "Thirty named triggers in four kinds (static gate, dynamic gate, moment, filter). The AND-list rules Zod enforces in RiderWhenSchema - at most one moment, a filter needs a moment, no repeated type - are structural refinements this document deliberately does not restate.",
      "oneOf": [
        { "type": "object", "required": ["type"], "properties": { "type": { "const": "attuned" } }, "additionalProperties": false },
        { "type": "object", "required": ["type"], "properties": { "type": { "const": "while-armored" }, "weights": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "enum": ["light", "medium", "heavy"] } } }, "additionalProperties": false },
        { "type": "object", "required": ["type"], "properties": { "type": { "const": "while-unarmored" }, "allowShield": { "type": "boolean" } }, "additionalProperties": false },
        { "type": "object", "required": ["type"], "properties": { "type": { "const": "while-shield" }, "wielding": { "type": "boolean" } }, "additionalProperties": false },
        { "type": "object", "required": ["type"], "properties": { "type": { "const": "while-character-is" }, "classIds": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/slug" } }, "speciesIds": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/slug" } } }, "additionalProperties": false },
        { "type": "object", "required": ["type", "kind", "ids"], "properties": { "type": { "const": "while-proficient-with" }, "kind": { "enum": ["weapon", "armor", "tool", "skill"] }, "ids": { "$ref": "#/$defs/slugList" } }, "additionalProperties": false },
        { "type": "object", "required": ["type", "tags"], "properties": { "type": { "const": "while-effect-tag" }, "tags": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "$ref": "#/$defs/effectTag" } } }, "additionalProperties": false },
        { "type": "object", "required": ["type", "percent"], "properties": { "type": { "const": "while-hp-at-or-below" }, "percent": { "type": "integer", "minimum": 1, "maximum": 99 } }, "additionalProperties": false },
        { "type": "object", "required": ["type", "conditionIds"], "properties": { "type": { "const": "while-condition" }, "conditionIds": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "$ref": "#/$defs/conditionId" } }, "present": { "type": "boolean" } }, "additionalProperties": false },
        { "type": "object", "required": ["type"], "properties": { "type": { "enum": ["on-attack-roll", "on-hit", "on-critical-hit", "on-critical-miss", "on-damage-roll", "on-saving-throw", "on-ability-check", "on-initiative-roll", "on-death-save", "on-taking-damage", "on-spell-cast"] } }, "additionalProperties": false },
        { "type": "object", "required": ["type", "kinds"], "properties": { "type": { "const": "attack-kind-is" }, "kinds": { "type": "array", "minItems": 1, "maxItems": 7, "items": { "enum": ["melee", "ranged", "spell", "unarmed", "thrown", "reaction", "opportunity"] } } }, "additionalProperties": false },
        { "type": "object", "required": ["type", "properties"], "properties": { "type": { "const": "weapon-property-is" }, "properties": { "$ref": "#/$defs/slugList" } }, "additionalProperties": false },
        { "type": "object", "required": ["type", "damageTypes"], "properties": { "type": { "const": "damage-type-is" }, "damageTypes": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "$ref": "#/$defs/damageTypeId" } } }, "additionalProperties": false },
        { "type": "object", "required": ["type", "abilities"], "properties": { "type": { "const": "ability-is" }, "abilities": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "$ref": "#/$defs/abilityId" } } }, "additionalProperties": false },
        { "type": "object", "required": ["type", "skills"], "properties": { "type": { "const": "skill-is" }, "skills": { "$ref": "#/$defs/slugList" } }, "additionalProperties": false },
        { "type": "object", "required": ["type", "schools"], "properties": { "type": { "const": "spell-school-is" }, "schools": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/slug" } } }, "additionalProperties": false },
        { "type": "object", "required": ["type", "levels"], "properties": { "type": { "const": "spell-level-is" }, "levels": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "type": "integer", "minimum": 0, "maximum": 9 } } }, "additionalProperties": false },
        { "type": "object", "required": ["type", "spellIds"], "properties": { "type": { "const": "spell-id-is" }, "spellIds": { "$ref": "#/$defs/slugList" } }, "additionalProperties": false },
        { "type": "object", "required": ["type", "creatureTypes"], "properties": { "type": { "const": "versus-creature-type" }, "creatureTypes": { "$ref": "#/$defs/slugList" } }, "additionalProperties": false },
        { "type": "object", "required": ["type", "sizes"], "properties": { "type": { "const": "versus-size" }, "sizes": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "$ref": "#/$defs/size" } } }, "additionalProperties": false },
        { "type": "object", "required": ["type", "conditionIds"], "properties": { "type": { "const": "versus-condition" }, "conditionIds": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "$ref": "#/$defs/conditionId" } } }, "additionalProperties": false }
      ]
    },
    "riderWhen": { "type": "array", "maxItems": 4, "items": { "$ref": "#/$defs/riderTrigger" } },
    "riderScope": { "enum": ["bearer", "this-item"] },
    "effectModifier": {
      "oneOf": [
        { "type": "object", "required": ["type", "amount"], "properties": { "type": { "const": "damage-bonus" }, "amount": { "type": "integer", "minimum": -20, "maximum": 20 }, "appliesTo": { "enum": ["melee", "all"] } }, "additionalProperties": false },
        { "type": "object", "required": ["type", "damageTypes"], "properties": { "type": { "const": "damage-resistance" }, "damageTypes": { "$ref": "#/$defs/damageTypeList" } }, "additionalProperties": false },
        { "type": "object", "required": ["type", "damageTypes"], "properties": { "type": { "const": "damage-vulnerability" }, "damageTypes": { "$ref": "#/$defs/damageTypeList" } }, "additionalProperties": false },
        { "type": "object", "required": ["type"], "properties": { "type": { "const": "attack-advantage" } }, "additionalProperties": false },
        { "type": "object", "required": ["type"], "properties": { "type": { "const": "incoming-attack-advantage" } }, "additionalProperties": false },
        { "type": "object", "required": ["type"], "properties": { "type": { "const": "attack-disadvantage" } }, "additionalProperties": false },
        { "type": "object", "required": ["type"], "properties": { "type": { "const": "incoming-attack-disadvantage" } }, "additionalProperties": false },
        { "type": "object", "required": ["type"], "properties": { "type": { "const": "save-advantage" }, "ability": { "enum": ["str", "dex", "con", "int", "wis", "cha"] } }, "additionalProperties": false },
        { "type": "object", "required": ["type"], "properties": { "type": { "const": "save-disadvantage" }, "ability": { "enum": ["str", "dex", "con", "int", "wis", "cha"] } }, "additionalProperties": false },
        { "type": "object", "required": ["type", "amount"], "properties": { "type": { "const": "attack-bonus" }, "amount": { "type": "integer", "minimum": -10, "maximum": 10 }, "when": { "$ref": "#/$defs/riderWhen" }, "scope": { "$ref": "#/$defs/riderScope" } }, "additionalProperties": false },
        { "type": "object", "required": ["type", "damageType"], "properties": { "type": { "const": "extra-damage" }, "formula": { "$ref": "#/$defs/dice" }, "abilityModifier": { "$ref": "#/$defs/abilityId" }, "damageType": { "$ref": "#/$defs/damageTypeId" }, "doubleOnCritical": { "type": "boolean" }, "when": { "$ref": "#/$defs/riderWhen" }, "scope": { "$ref": "#/$defs/riderScope" } }, "additionalProperties": false },
        { "type": "object", "required": ["type", "roll", "mode"], "properties": { "type": { "const": "roll-mode" }, "roll": { "enum": ["attack", "incoming-attack", "save", "check", "initiative", "death-save", "concentration"] }, "mode": { "enum": ["advantage", "disadvantage"] }, "when": { "$ref": "#/$defs/riderWhen" }, "scope": { "$ref": "#/$defs/riderScope" } }, "additionalProperties": false }
      ]
    },
    "action": {
      "type": "object", "required": ["id", "name", "activation", "description"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" }, "name": { "type": "string", "minLength": 1, "maxLength": 120 }, "activation": { "enum": ["action", "bonus-action", "reaction", "other"] }, "description": { "type": "string", "minLength": 1, "maxLength": 12000 },
        "attack": { "type": "object", "required": ["bonus"], "properties": { "bonus": { "type": "integer" }, "reachFeet": { "type": "integer", "minimum": 1 }, "rangeFeet": { "type": "integer", "minimum": 1 }, "rangeNormalFeet": { "type": "integer", "minimum": 1 }, "count": { "type": "integer", "minimum": 1, "maximum": 10 }, "criticalBonusDice": { "type": "integer", "minimum": 1, "maximum": 4 } }, "additionalProperties": false },
        "save": { "type": "object", "required": ["ability", "dc"], "properties": { "ability": { "enum": ["str", "dex", "con", "int", "wis", "cha"] }, "dc": { "type": "integer", "minimum": 1, "maximum": 40 } }, "additionalProperties": false },
        "damage": { "type": "array", "maxItems": 8, "items": { "type": "object", "required": ["formula", "type"], "properties": { "formula": { "$ref": "#/$defs/dice" }, "type": { "type": "string", "minLength": 1, "maxLength": 40 } }, "additionalProperties": false } },
        "multiattack": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "type": "object", "required": ["actionId", "count"], "properties": { "actionId": { "type": "string", "pattern": "^[a-z0-9-]+$" }, "count": { "type": "integer", "minimum": 1, "maximum": 4 } }, "additionalProperties": false } },
        "onHit": { "type": "array", "maxItems": 2, "items": { "type": "object", "required": ["conditions"], "properties": { "conditions": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "object", "required": ["id"], "properties": { "id": { "$ref": "#/$defs/conditionId" }, "level": { "type": "integer", "minimum": 1, "maximum": 6 } }, "additionalProperties": false } }, "escapeDc": { "type": "integer", "minimum": 1, "maximum": 40 }, "maxTargetSize": { "$ref": "#/$defs/size" } }, "additionalProperties": false } },
        "targetRules": { "type": "array", "maxItems": 2, "items": { "enum": ["not-grappled-by-source"] } },
        "grants": { "type": "object", "required": ["tags", "duration"], "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 120 }, "tags": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/effectTag" } }, "duration": { "oneOf": [{ "type": "object", "required": ["type", "rounds"], "properties": { "type": { "const": "rounds" }, "rounds": { "type": "integer", "minimum": 1, "maximum": 100 } }, "additionalProperties": false }, { "type": "object", "required": ["type"], "properties": { "type": { "enum": ["until-source-next-turn", "encounter", "manual"] } }, "additionalProperties": false }] }, "modifiers": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/effectModifier" } }, "onEnd": { "type": "array", "maxItems": 2, "items": { "type": "object", "required": ["type", "conditionId"], "properties": { "type": { "const": "condition" }, "conditionId": { "$ref": "#/$defs/conditionId" }, "level": { "type": "integer", "minimum": 1, "maximum": 6 } }, "additionalProperties": false } }, "endsWithTag": { "$ref": "#/$defs/effectTag" }, "target": { "enum": ["self", "target"] }, "voidWhileIncapacitated": { "type": "boolean" }, "concentration": { "type": "boolean" } }, "additionalProperties": false },
        "requiresEffectTag": { "$ref": "#/$defs/effectTag" },
        "uses": { "type": "object", "required": ["limit", "per"], "properties": { "limit": { "type": "integer", "minimum": 1, "maximum": 20 }, "per": { "enum": ["turn", "encounter", "long-rest", "short-rest", "recharge"] }, "pool": { "type": "string", "pattern": "^[a-z0-9-]+$", "maxLength": 60 }, "recharge": { "type": "integer", "minimum": 2, "maximum": 6 } }, "additionalProperties": false },
        "spellSlot": { "type": "object", "required": ["level"], "properties": { "level": { "type": "integer", "minimum": 1, "maximum": 9 } }, "additionalProperties": false },
