    "features": [
      {
        "id": "fighting-style",
        "name": "Fighting Style",
        "level": 1,
        "description": "You have honed your martial prowess and gain a Fighting Style feat of your choice. Whenever you gain a Fighter level, you can replace the feat you chose with a different Fighting Style feat.",
        "tags": [
          "fighting-style"
        ],
        "choice": {
          "kind": "fighting-style",
          "choose": 1,
          "fromCatalog": "fighting-style-feats"
        }
      },
      {
        "id": "second-wind",
        "name": "Second Wind",
        "level": 1,
        "description": "You have a limited well of physical and mental stamina that you can draw on. As a Bonus Action, you can regain Hit Points equal to 1d10 plus your Fighter level. You regain one expended use when you finish a Short Rest, and you regain all expended uses when you finish a Long Rest.",
        "tags": [
          "healing"
        ],
        "actions": [
          {
            "id": "second-wind",
            "name": "Second Wind",
            "activation": "bonus-action",
            "description": "Regain Hit Points equal to 1d10 plus your Fighter level.",
            "damage": []
          }
        ],
        "uses": {
          "per": "long-rest",
          "scaling": {
            "type": "by-level",
            "table": [
              {
                "level": 1,
                "limit": 2
              },
              {
                "level": 4,
                "limit": 3
              },
              {
                "level": 10,
                "limit": 4
              }
            ]
          }
        }
      },
      {
        "id": "weapon-mastery",
        "name": "Weapon Mastery",
        "level": 1,
        "description": "Your training with weapons allows you to use the mastery property of three kinds of Simple or Martial weapons of your choice. Whenever you finish a Long Rest, you can change the kinds of weapons you chose.",
        "tags": [
          "weapon-mastery"
        ],
        "choice": {
          "kind": "weapon-mastery",
          "choose": 3,
          "fromCatalog": "weapons",
          "repeatable": false
        }
      },
      {
        "id": "action-surge",
        "name": "Action Surge",
        "level": 2,
        "description": "You can push yourself beyond your normal limits for a moment. On your turn, you can take one additional action, except the Magic action. Once you use this feature, you can't do so again until you finish a Short or Long Rest.",
        "tags": [
          "action-economy"
        ],
        "uses": {
          "per": "short-rest",
          "scaling": {
            "type": "by-level",
            "table": [
              {
                "level": 2,
                "limit": 1
              },
              {
                "level": 17,
                "limit": 2
              }
            ]
          }
        }
      },
      {
        "id": "tactical-mind",
        "name": "Tactical Mind",
        "level": 2,
        "description": "You have a mind for tactics on and off the battlefield. When you fail an ability check, you can expend a use of Second Wind to push yourself toward success. Roll 1d10 and add it to the check, potentially turning it into a success. If the check still fails, this use of Second Wind isn't expended."
      },
      {
        "id": "fighter-subclass",
        "name": "Fighter Subclass",
        "level": 3,
        "description": "You gain a Fighter subclass of your choice. A subclass is a specialization that grants you features at certain Fighter levels.",
        "tags": [
          "subclass"
        ],
        "choice": {
          "kind": "subclass",
          "choose": 1,
          "fromCatalog": "fighter-subclasses"
        }
      },
      {
        "id": "ability-score-improvement",
        "name": "Ability Score Improvement",
        "description": "You gain the Ability Score Improvement feat or another feat of your choice for which you qualify. You can take this feature more than once.",
        "tags": [
          "asi"
        ],
        "choice": {
          "kind": "asi-or-feat",
          "choose": 1,
          "fromCatalog": "general-feats",
          "repeatable": true
        }
      },
      {
        "id": "extra-attack",
        "name": "Extra Attack",
        "level": 5,
        "description": "You can attack twice, instead of once, whenever you take the Attack action on your turn.",
        "modifiers": [
          {
            "type": "extra-attack",
            "count": 1
          }
        ]
      },
      {
        "id": "tactical-shift",
        "name": "Tactical Shift",
        "level": 5,
        "description": "Whenever you activate your Second Wind with a Bonus Action, you can move up to half your Speed without provoking Opportunity Attacks."
      },
      {
        "id": "indomitable",
        "name": "Indomitable",
        "level": 9,
        "description": "If you fail a saving throw, you can reroll it with a bonus equal to your Fighter level. You must use the new roll, and you can't use this feature again until you finish a Long Rest.",
        "uses": {
          "per": "long-rest",
          "scaling": {
            "type": "by-level",
            "table": [
              {
                "level": 9,
                "limit": 1
              },
              {
                "level": 13,
                "limit": 2
              },
              {
                "level": 17,
                "limit": 3
              }
            ]
          }
        }
      },
      {
        "id": "tactical-master",
        "name": "Tactical Master",
        "level": 9,
        "description": "When you attack with a weapon whose mastery property you can use, you can replace that property with the Push, Sap, or Slow property for that attack."
      },
      {
        "id": "two-extra-attacks",
        "name": "Two Extra Attacks",
        "level": 11,
        "description": "You can attack three times, instead of once, whenever you take the Attack action on your turn.",
        "modifiers": [
          {
            "type": "extra-attack",
            "count": 2
          }
        ],
        "replacesFeatureId": "extra-attack"
      },
      {
        "id": "studied-attacks",
        "name": "Studied Attacks",
        "level": 13,
        "description": "You study your opponents and learn from each attack you make. If you make an attack roll against a creature and miss, you have Advantage on your next attack roll against that creature before the end of your next turn."
      },
      {
        "id": "epic-boon",
        "name": "Epic Boon",
        "level": 19,
        "description": "You gain an Epic Boon feat or another feat of your choice for which you qualify.",
        "tags": [
          "feat"
        ],
        "choice": {
          "kind": "feat",
          "choose": 1,
          "fromCatalog": "epic-boon-feats"
        }
      },
      {
        "id": "three-extra-attacks",
        "name": "Three Extra Attacks",
        "level": 20,
        "description": "You can attack four times, instead of once, whenever you take the Attack action on your turn.",
        "modifiers": [
          {
            "type": "extra-attack",
            "count": 3
          }
        ],
        "replacesFeatureId": "two-extra-attacks"
      }
    ]
  },
