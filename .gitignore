node_modules/
dist/
.env
data/
*.log
*.tsbuildinfo

# Personal, machine-local Claude Code overrides (shared config lives in .claude/settings.json)
.claude/settings.local.json
# Uncommitted (local-scope) subagent memory; project-scope .claude/agent-memory/ IS committed
.claude/agent-memory-local/

# Smoke-suite output (`npm run smoke`): traces and the HTML report of the last run.
/e2e/test-results/
/e2e/playwright-report/

# node_modules as a SYMLINK, not just a directory. A worktree set up by linking to the main
# checkout's tree — or a link that ends up pointing at its own path, which is how this one
# arrived — is a file, and `node_modules/` does not match a file. It reached the index once.
node_modules

# Subagent worktrees live under the checkout so their branches share this clone's objects;
# their CONTENTS are those branches' business, never this one's index.
.claude/worktrees/
