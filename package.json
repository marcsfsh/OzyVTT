{
  "name": "vtt",
  "private": true,
  "version": "0.1.0",
  "description": "Private, LAN-hosted D&D 5e virtual tabletop and worldbuilding Codex",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,server -c cyan,magenta \"npm run dev --workspace=@vtt/web\" \"npm run dev --workspace=@vtt/server\"",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run check --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "start": "npm run build && npm run start --workspace=@vtt/server",
    "map": "npm run map --workspace=@vtt/server",
    "content": "npm run content --workspace=@vtt/content-srd-5.2.1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.1",
    "concurrently": "^9.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.71.2"
  }
}
